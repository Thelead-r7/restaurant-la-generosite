# =========================================================
# Chez Tantie V2 — Variables d'environnement
# Copier ce fichier en `.env` LOCALEMENT (jamais commité)
# et configurer les mêmes variables dans Vercel Dashboard.
# =========================================================

# --- Supabase : URL du projet (public, visible dans le dashboard)
SUPABASE_URL=https://VOTRE-PROJET.supabase.co

# --- Clé publique anonyme (utilisée côté client, sécurité via RLS)
# Cette clé sera aussi copiée dans js/supabase-config.js
SUPABASE_ANON_KEY=eyJhbGciOi...ANON

# --- Clé service role (SECRÈTE — jamais exposée au frontend)
# Utilisée uniquement par les fonctions /api/ côté serveur
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...SERVICE

# --- Secret de session pour signature des JWT custom (facultatif)
# Optionnel si on utilise uniquement les JWT Supabase natifs
SESSION_SECRET=chaine-aleatoire-longue-a-generer

# --- Environnement (development | preview | production)
NODE_ENV=development
